# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
synopsis: "Advent of Code solutions in OCaml"
description:
  "Solutions to Advent of Code puzzles, one library per day with inline expect tests."
maintainer: ["Aline"]
authors: ["Aline"]
tags: ["advent of code" "aoc" "puzzles"]
homepage: "https://github.com/alinespereira/ocaml-aoc"
bug-reports: "https://github.com/alinespereira/ocaml-aoc/issues"
depends: [
  "dune" {>= "3.24"}
  "ocaml"
  "base"
  "core"
  "angstrom"
  "ppx_deriving"
  "ppx_enumerate"
  "ppx_expect"
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/alinespereira/ocaml-aoc.git"
x-maintenance-intent: ["(latest)"]
